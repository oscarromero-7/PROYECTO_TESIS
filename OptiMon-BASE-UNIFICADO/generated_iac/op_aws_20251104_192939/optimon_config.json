{
  "provider": "aws",
  "project_name": "op",
  "environment": "staging",
  "region": "us-east-1",
  "include_networking": true,
  "compute_resources": [
    {
      "name": "web-server-1",
      "instance_type": "t3.micro",
      "disk_size": "20",
      "security_rules": [
        {
          "type": "ingress",
          "from_port": "22",
          "to_port": "22",
          "protocol": "tcp",
          "cidr": "0.0.0.0/0",
          "description": "Allow SSH (22)"
        }
      ]
    }
  ]
}