{
  "panels": [
    {
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "100 - (avg(irate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "(1 - (windows_os_physical_memory_free_bytes / windows_os_total_visible_memory_bytes)) * 100",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "100 - (windows_logical_disk_free_bytes / windows_logical_disk_size_bytes * 100)",
          "refId": "A"
        }
      ],
      "title": "Disk Usage",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "tags": [
    "optimon",
    "local",
    "unified"
  ],
  "timezone": "browser",
  "title": "OptiMon - Sistema Local Unificado",
  "uid": "optimon-local"
}
